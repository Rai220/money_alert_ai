# Провайдер LLM для lc_money_alert_bot.py: gigachat, openai или gemini
# MODEL_PROVIDER=gigachat

# GigaChat (обязательно при MODEL_PROVIDER=gigachat)
GIGACHAT_USER=your_username
GIGACHAT_PASSWORD=your_password
GIGACHAT_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1
GIGACHAT_VERIFY_SSL_CERTS=False
GIGACHAT_MODEL=GigaChat-2-Max

# OpenAI (обязательно при MODEL_PROVIDER=openai)
# OPENAI_API_KEY=sk-xxxxx
# OPENAI_MODEL=gpt-5.2
# OPENAI_BASE_URL=              # опционально, для совместимых API

# Gemini (обязательно при MODEL_PROVIDER=gemini)
# GOOGLE_API_KEY=AIza...
# GEMINI_MODEL=gemini-3.1-pro-preview

# Обязательно для lc_money_alert_bot.py: Tavily (поиск)
TAVILY_API_KEY=tvly-xxxxx

# Опционально: путь к файлу критериев (по умолчанию criteria.json)
# CRITERIA_FILE=criteria_small.json
# Старый профиль (архив): риск заморозки вкладов
# CRITERIA_FILE=criteria_deposit_freeze.json

# Опционально: Telegram бот для отправки отчётов
# TELEGRAM_BOT_TOKEN=123456789:...
# TELEGRAM_CHANNEL_ID=...
# TELEGRAM_ADMIN_CHAT_ID=